DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set False behind an edge TLS proxy if internal health checks use plain HTTP, or keep True with SECURE_REDIRECT_EXEMPT
DJANGO_SECURE_SSL_REDIRECT=False

# Database configuration (MySQL is the primary/default database)
DB_ENGINE=mysql
DB_NAME=stockflow_db
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
# Managed cloud MySQL TLS (e.g. TiDB Cloud Starter on Linux uses /etc/ssl/certs/ca-certificates.crt)
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# DB_SSL_MODE=REQUIRED
# Optional local fallback when MySQL is unavailable:
# DB_ENGINE=sqlite3

# Inventory defaults
DEFAULT_LOW_STOCK_THRESHOLD=5

# CORS & CSRF configuration for React + Vite dev server or production Vercel domain
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
